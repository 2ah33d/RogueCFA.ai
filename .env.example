# RogueCFA.ai — Environment Variables
# ====================================
# API keys can be pre-configured as environment variables below (or in Vercel dashboard)
# so the application no longer requires a Bring-Your-Own-Key (BYOK) setup screen.
# If a user provides custom keys in Settings, those will override environment variables.

# Core Financial Data & LLM Keys (Server-side & Client Build)
FINNHUB_KEY=your_finnhub_api_key
LLM_KEY=your_llm_api_key_or_gemini_key
LLM_PROVIDER=gemini
ALPHAVANTAGE_KEY=your_alphavantage_key

# Client-side Vite Environment Variables (Optional client build fallbacks)
VITE_FINNHUB_KEY=your_finnhub_api_key
VITE_LLM_KEY=your_llm_api_key
VITE_LLM_PROVIDER=gemini
VITE_ALPHAVANTAGE_KEY=your_alphavantage_key

# Supabase Database Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsIn...your-service-role-secret-key

# Cron Job & Debug Variables
CRON_SECRET=super-secret-cron-token
CRON_LLM_KEY=sk-ant-api03...
CRON_LLM_PROVIDER=claude
CRON_GROQ_KEY=gsk_...
CRON_YOUTUBE_KEY=AIzaSy...
DEBUG_SECRET=super-secret-debug-token

# YouTube yt-dlp Micro-Worker (for audio extraction from BNN Bloomberg's YouTube channel)
YT_DLP_WORKER_URL=https://your-ytdlp-worker.modal.run/extract
YT_DLP_WORKER_SECRET=optional-bearer-token-for-worker-auth


